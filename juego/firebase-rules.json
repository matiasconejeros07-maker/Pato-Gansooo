{
  "rules": {
    ".read": false,
    ".write": false,
    "scores": {
      ".read": true,
      ".indexOn": ["s"],
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{12,32}$/) && (!data.exists() || newData.child('s').val() >= data.child('s').val())",
        ".validate": "newData.hasChildren(['n', 's', 't'])",
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
        "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
